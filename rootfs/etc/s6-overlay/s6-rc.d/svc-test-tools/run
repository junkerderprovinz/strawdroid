#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Puts the two apps most tests reach for on the device and keeps Shizuku
# running. PCAPdroid records which hosts an app talks to, without root.
# Shizuku gives apps the shell's privileges, which many system tools, app
# managers and FPS meters ask for, and its server dies with every reboot of the
# emulator, so it is started again whenever it is missing.
#
# The apps are installed once per AVD, and the marker sits inside the AVD, so a
# new device gets them and removing one by hand keeps it removed.
# TEST_TOOLS=false leaves both alone.
APK=/defaults/apk
MARKER="${ANDROID_AVD_HOME:-/config/.android/avd}/${AVD_NAME:-strawdroid}.avd/.strawdroid-test-tools"

if [[ "${TEST_TOOLS,,}" != "true" ]]; then
    echo "[svc-test-tools] TEST_TOOLS is off, Shizuku and PCAPdroid are not installed"
    exec sleep infinity
fi

declare -A PACKAGES=([shizuku]=moe.shizuku.privileged.api [pcapdroid]=com.emanuelef.remote_capture)

booted() {
    [[ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r\n')" == "1" ]]
}

# On a fresh AVD svc-branding restarts adbd and then the framework, and an
# install that runs at the same time fails with the device offline.
for _ in $(seq 1 300); do
    [[ -f /run/strawdroid-branding-done ]] && break
    sleep 2
done

attempts=0
while :; do
    if booted; then
        # An app that is already there stays as it is, so a copy from F-Droid,
        # signed differently, is not fought over.
        if [[ ! -f "${MARKER}" ]]; then
            missing=0
            for app in shizuku pcapdroid; do
                adb shell pm path "${PACKAGES[${app}]}" >/dev/null 2>&1 && continue
                if out="$(adb install -r "${APK}/${app}.apk" 2>&1)"; then
                    echo "[svc-test-tools] ${app} installed"
                else
                    echo "[svc-test-tools] ${app} did not install: ${out##*$'\n'}"
                    missing=1
                fi
            done
            attempts=$((attempts + 1))
            if [[ "${missing}" -eq 0 || "${attempts}" -ge 5 ]]; then
                touch "${MARKER}"
            fi
        fi

        if ! adb shell pidof shizuku_server >/dev/null 2>&1; then
            dir="$(adb shell pm path "${PACKAGES[shizuku]}" 2>/dev/null | tr -d '\r' | sed -n 's#^package:\(.*\)/base\.apk$#\1#p')"
            if [[ -n "${dir}" ]] && adb shell "${dir}/lib/x86_64/libshizuku.so" >/dev/null 2>&1; then
                echo "[svc-test-tools] Shizuku server started"
            fi
        fi
    fi
    sleep 30
done
