#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# A longrun, so s6 brings the emulator back if it dies. It draws as an X client
# on the Selkies display.
AVD_NAME="${AVD_NAME:-strawdroid}"

# The base image sets DISPLAY for the desktop session only. Without it the
# emulator runs headless, which from the WebUI looks like it never started.
export DISPLAY="${DISPLAY:-:1}"

# Started before the X server, the emulator exits with "cannot open display"
# and s6 restarts it in a loop.
for _ in $(seq 1 120); do
    if xdpyinfo -display "${DISPLAY:-:1}" >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

# NVIDIA arrives through the nvidia runtime, Intel and AMD through /dev/dri.
gpu="${EMULATOR_GPU:-auto}"
nvidia=false
if which nvidia-smi >/dev/null 2>&1 && ls -A /dev/dri >/dev/null 2>&1; then
    nvidia=true
fi
if [[ "${gpu}" == auto ]]; then
    if [[ "${nvidia}" == true ]] || compgen -G "/dev/dri/renderD*" >/dev/null; then
        gpu=host
    else
        gpu=swiftshader_indirect
    fi
fi

# The variables startwm.sh exports for the desktop, which this service does not
# inherit. With them the emulator gets NVIDIA's own OpenGL rather than Mesa's
# zink layered over the Vulkan driver. Intel and AMD get DRI3 from Xvfb.
if [[ "${gpu}" == host && "${nvidia}" == true && "${DISABLE_ZINK,,}" == false ]]; then
    export LIBGL_KOPPER_DRI2=1
    export MESA_LOADER_DRIVER_OVERRIDE=zink
    export GALLIUM_DRIVER=zink
fi

echo "[svc-emulator] starting ${AVD_NAME} on ${DISPLAY:-:1} (gpu=${gpu}, EMULATOR_GPU=${EMULATOR_GPU:-auto})"

# Without it the modem never connects on a Docker network, and Android has no
# SIM; lib/numeric-addrconfig.c explains why. The launcher keeps what is in
# LD_PRELOAD and adds its own, so Selkies' interposers stay in place.
export LD_PRELOAD="/usr/local/lib/strawdroid/libnumeric-addrconfig.so${LD_PRELOAD:+:${LD_PRELOAD}}"

# The emulator's own default number, 555-521-5554, is not a valid number to
# libphonenumber, and SMS apps that check numbers hide such a contact.
args=()
if [[ -n "${EMULATOR_PHONE_NUMBER}" ]]; then
    args+=(-phone-number "${EMULATOR_PHONE_NUMBER}")
fi

# svc-root puts su into the system partition, which stays read-only without
# this.
if [[ "${ROOT,,}" == "true" ]]; then
    args+=(-writable-system)
fi

# Selkies runs PulseAudio for the desktop, so the emulator's sound reaches the
# browser through it.
#
# Without host audio the microphone is silent, and the default source is the
# desktop's own output, so the phone would hear itself. It records from
# Selkies' "input" sink instead, which carries the browser's microphone and
# whatever `sk mic` plays. Selkies creates that sink a few seconds after
# PulseAudio starts.
if [[ "${EMULATOR_AUDIO,,}" != "true" ]]; then
    args+=(-no-audio)
else
    for _ in $(seq 1 30); do
        if pactl list short sources 2>/dev/null | cut -f2 | grep -qx input.monitor; then
            export PULSE_SOURCE=input.monitor
            args+=(-allow-host-audio)
            break
        fi
        sleep 1
    done
    [[ -n "${PULSE_SOURCE:-}" ]] || echo "[svc-emulator] Selkies has no input sink, so the microphone stays silent"
fi

# The back camera shows a picture that `sk camera` swaps, a QR code to begin
# with, so scanning apps can be tested. The emulator reads the file again each
# time an app opens the camera.
camera_back="${EMULATOR_CAMERA_BACK:-picture}"
if [[ "${camera_back}" == picture ]]; then
    mkdir -p /config/camera
    [[ -f /config/camera/back.png ]] || cp /defaults/seed/codes/qr-url.png /config/camera/back.png
    chown -R abc:abc /config/camera
    camera_back=imagefile:/config/camera/back.png
fi

# -no-snapshot-save: a saved snapshot would carry the last session's state,
# half-open dialogs and earlier permissions included, into the next start, and
# a test rig has to start clean.
#
# -no-metrics: without it a leftover crash record makes the emulator wait for
# consent in a crash dialog ("Showing crashdialog to get consent"), and it never
# boots. Metrics stay off because the rig runs unfinished code.
exec s6-setuidgid abc \
    "${ANDROID_SDK_ROOT}/emulator/emulator" \
    -avd "${AVD_NAME}" \
    -gpu "${gpu}" \
    -no-snapshot-save \
    -no-metrics \
    -no-boot-anim \
    -camera-back "${camera_back}" \
    -camera-front "${EMULATOR_CAMERA_FRONT:-emulated}" \
    "${args[@]}" \
    ${EMULATOR_EXTRA_ARGS}
