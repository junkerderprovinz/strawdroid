#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# A longrun, so s6 brings the emulator back if it dies. It draws as an X client
# on the Selkies display.
AVD_NAME="${AVD_NAME:-strawdroid}"

# The base image sets DISPLAY for the desktop session only. Without it the
# emulator runs headless, which from the WebUI looks like it never started.
export DISPLAY="${DISPLAY:-:1}"

# Started before the X server, the emulator exits with "cannot open display"
# and s6 restarts it in a loop.
for _ in $(seq 1 120); do
    if xdpyinfo -display "${DISPLAY:-:1}" >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

echo "[svc-emulator] starting ${AVD_NAME} on ${DISPLAY:-:1} (gpu=${EMULATOR_GPU})"

# Without it the modem never connects on a Docker network, and Android has no
# SIM; lib/numeric-addrconfig.c explains why. The launcher keeps what is in
# LD_PRELOAD and adds its own, so Selkies' interposers stay in place.
export LD_PRELOAD="/usr/local/lib/strawdroid/libnumeric-addrconfig.so${LD_PRELOAD:+:${LD_PRELOAD}}"

# The emulator's own default number, 555-521-5554, is not a valid number to
# libphonenumber, and SMS apps that check numbers hide such a contact.
args=()
if [[ -n "${EMULATOR_PHONE_NUMBER}" ]]; then
    args+=(-phone-number "${EMULATOR_PHONE_NUMBER}")
fi

# svc-root puts su into the system partition, which stays read-only without
# this.
if [[ "${ROOT,,}" == "true" ]]; then
    args+=(-writable-system)
fi

# Selkies runs PulseAudio for the desktop, so the emulator's sound reaches the
# browser through it.
if [[ "${EMULATOR_AUDIO,,}" != "true" ]]; then
    args+=(-no-audio)
fi

# -no-snapshot-save: a saved snapshot would carry the last session's state,
# half-open dialogs and earlier permissions included, into the next start, and
# a test rig has to start clean.
#
# -no-metrics: without it a leftover crash record makes the emulator wait for
# consent in a crash dialog ("Showing crashdialog to get consent"), and it never
# boots. Metrics stay off because the rig runs unfinished code.
exec s6-setuidgid abc \
    "${ANDROID_SDK_ROOT}/emulator/emulator" \
    -avd "${AVD_NAME}" \
    -gpu "${EMULATOR_GPU}" \
    -no-snapshot-save \
    -no-metrics \
    -no-boot-anim \
    -camera-back "${EMULATOR_CAMERA_BACK:-emulated}" \
    -camera-front "${EMULATOR_CAMERA_FRONT:-emulated}" \
    "${args[@]}" \
    ${EMULATOR_EXTRA_ARGS}
