#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Mirrors the share into the phone so its own file manager can reach it. The
# emulated phone is a virtual machine with its own kernel and disk, so no host
# directory can be mounted into it; the emulator has no shared folders, the
# Files app has no SMB client, and an SD card image is a snapshot. adb crosses
# the boundary, so this copies.
#
# Host to phone only, matching the share's read-only mount, because the rig runs
# unfinished code. The files land in /sdcard/Download/share, where the Files
# app looks and the SAF picker offers them without granting a tree first.
#
# Only the top-level files are mirrored, because a recursive pass over a
# download share of 49,000 files takes 100 seconds against a 30-second
# interval. The use here is dropping in a build to install; `sk push <dir>`
# copies a tree on demand.
SHARE="${SHARE_DIR:-/share}"
DEST="/sdcard/Download/share"
EVERY="${SHARE_MIRROR_SECONDS:-30}"

if [ ! -d "${SHARE}" ]; then
    echo "[svc-share-mirror] no ${SHARE} mounted, nothing to mirror"
    # s6 restarts a longrun that exits, which would repeat this line forever.
    exec sleep infinity
fi

# A cold start takes minutes.
for _ in $(seq 1 180); do
    [ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r\n')" = "1" ] && break
    sleep 5
done

adb shell mkdir -p "${DEST}" >/dev/null 2>&1 || true
echo "[svc-share-mirror] mirroring ${SHARE} into ${DEST} every ${EVERY}s"

too_big=""
wanted="$(mktemp)"
trap 'rm -f "${wanted}"' EXIT

while :; do
    # A download share grows, and a full emulator disk later shows up as an app
    # that will not install. Over the cap nothing is mirrored rather than part
    # of the share, because a partial mirror hides which file is missing.
    size="$(du -sm "${SHARE}" 2>/dev/null | cut -f1)"
    if [ -n "${size}" ] && [ "${size}" -gt "${SHARE_MIRROR_MAX_MB:-2048}" ]; then
        # Logged once per crossing, not on every pass.
        if [ "${too_big}" != "yes" ]; then
            echo "[svc-share-mirror] ${SHARE} is ${size} MB, over the ${SHARE_MIRROR_MAX_MB:-2048} MB cap; not mirroring."
            echo "[svc-share-mirror] Point the mount at a smaller folder, or raise SHARE_MIRROR_MAX_MB. 'sk install' still works."
            too_big="yes"
        fi
        sleep "${EVERY}"
        continue
    fi
    if [ "${too_big}" = "yes" ]; then
        echo "[svc-share-mirror] ${SHARE} is back under the cap at ${size} MB, mirroring again"
        too_big=""
    fi

    moved=0
    failed=0
    for file in "${SHARE}"/*; do
        [ -f "${file}" ] || continue
        name="$(basename "${file}")"
        printf '%s\n' "${name}" >>"${wanted}"
        # --sync compares size and timestamp, so an unchanged file costs a
        # comparison and no transfer.
        if out="$(adb push --sync "${file}" "${DEST}/${name}" 2>&1)"; then
            case "${out}" in *"0 files pushed"*|*"skipped"*) : ;; *) moved=$((moved + 1)) ;; esac
        else
            echo "[svc-share-mirror] could not send ${name}: ${out##*$'\n'}"
            failed=$((failed + 1))
        fi
    done

    # `adb push --sync` only adds and updates, so whatever left the share is
    # removed here, or the device would keep every old build. DEST belongs to
    # the mirror alone, so anything in it that is not in the share goes,
    # directories included.
    removed=0
    while IFS= read -r name; do
        [ -n "${name}" ] || continue
        if ! grep -qxF "${name}" "${wanted}" 2>/dev/null; then
            adb shell rm -rf "'${DEST}/${name}'" >/dev/null 2>&1 && removed=$((removed + 1))
        fi
    done <<<"$(adb shell "ls -1 '${DEST}' 2>/dev/null" | tr -d '\r')"

    if [ "${moved}" -gt 0 ] || [ "${removed}" -gt 0 ]; then
        echo "[svc-share-mirror] ${moved} sent, ${removed} removed"
        # Until the media scanner sees a file, the Files app and the picker do
        # not show it.
        adb shell am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE \
            -d "file://${DEST}" >/dev/null 2>&1 || true
    fi
    : >"${wanted}"
    sleep "${EVERY}"
done
