#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Runs after init-selkies-config, which seeds openbox's autostart and menu.xml
# from /defaults on first boot only. The autostart is copied again on every
# start so an image update reaches it; menu.xml stays first-boot-only so hand
# edits survive.
#
# The AVD is created once in /config and kept. It holds the installed app, the
# folder permission granted through the SAF picker and whatever a test wrote,
# and recreating it would look like the app forgetting its permission.
set -e

log() { echo "[init-strawdroid] $*"; }

CONFIG_HOME="/config/.config"
mkdir -p "${CONFIG_HOME}/openbox" \
         "/config/.local/share" \
         "/config/.cache" \
         "/config/.android/avd"

cp -af /defaults/autostart "${CONFIG_HOME}/openbox/autostart"
chmod 0755 "${CONFIG_HOME}/openbox/autostart"
log "autostart synced from /defaults/autostart"

# Without KVM the emulator refuses to start or crawls, and from outside either
# looks like a broken container, so the missing device is named here.
if [ -c /dev/kvm ] && [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
    log "KVM available"
else
    log "WARNING: /dev/kvm is missing or not writable; add --device=/dev/kvm to this container."
    log "WARNING: without it the emulator will not start."
fi

AVD_NAME="${AVD_NAME:-strawdroid}"
AVD_DIR="/config/.android/avd/${AVD_NAME}.avd"

# An AVD names its system image by path, and the container image ships only one
# Android level. After a level bump the emulator would fail with a message about a
# missing kernel, so a stale device is moved aside rather than deleted, where
# somebody can still look into it.
if [ -d "${AVD_DIR}" ]; then
    sysdir="$(sed -n 's/^image\.sysdir\.1=//p' "${AVD_DIR}/config.ini" 2>/dev/null | tr -d '\r')"
    if [ -n "${sysdir}" ] && [ ! -d "${ANDROID_SDK_ROOT}/${sysdir}" ]; then
        stamp="$(date +%Y%m%d-%H%M%S)"
        log "WARNING: AVD ${AVD_NAME} was built on ${sysdir}, which this image no longer carries."
        log "WARNING: moving it to ${AVD_NAME}.avd.old-${stamp} and building a fresh one on ${STRAWDROID_PACKAGE}."
        log "WARNING: anything installed on the old device, and any permission it was granted, is gone with it."
        mv "${AVD_DIR}" "${AVD_DIR}.old-${stamp}"
        mv "/config/.android/avd/${AVD_NAME}.ini" "/config/.android/avd/${AVD_NAME}.ini.old-${stamp}" 2>/dev/null || true
    fi
fi

if [ -d "${AVD_DIR}" ]; then
    log "AVD ${AVD_NAME} already exists, keeping it and everything installed on it"
else
    log "creating AVD ${AVD_NAME} from ${STRAWDROID_PACKAGE} (device ${EMULATOR_DEVICE})"
    # Without a hardware profile the AVD gets a generic square screen that
    # resembles no real phone.
    echo "no" | avdmanager create avd \
        --name "${AVD_NAME}" \
        --package "${STRAWDROID_PACKAGE}" \
        --device "${EMULATOR_DEVICE}" \
        --force >/dev/null

    # avdmanager's 384 MB of RAM and 800 MB of storage cannot hold an app plus
    # the files a sync tool moves, and running out of either shows up as a
    # crash.
    cfg="${AVD_DIR}/config.ini"
    {
        echo "hw.ramSize=${EMULATOR_RAM}"
        echo "disk.dataPartition.size=6G"
        echo "hw.keyboard=yes"
    } >> "${cfg}"
    log "AVD created"
fi

# abc is the user the emulator runs as, remapped to PUID:PGID by init-adduser.
# A default of 99:100 would be wrong when PUID is unset (abc is then 911), and
# the emulator would fail with "A snapshot operation ... is pending", which
# looks like a corrupt AVD.
chown -R abc:abc \
    "${CONFIG_HOME}" "/config/.local" "/config/.cache" "/config/.android" 2>/dev/null || true

log "init-strawdroid done"
exit 0
