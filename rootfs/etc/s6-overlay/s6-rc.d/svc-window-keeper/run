#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Keeps the emulator window on the screen. It can open partly above the visible
# area (at y = -551 on a 768-pixel desktop), and Selkies resizes the X display
# with every browser resize, so a one-off placement in openbox's rc.xml would not
# hold. The window is moved only when an edge is off screen, so a window
# somebody dragged to a visible spot stays there.
export DISPLAY="${DISPLAY:-:1}"

for _ in $(seq 1 120); do
    xdpyinfo >/dev/null 2>&1 && break
    sleep 1
done

# Matching the title, which carries the AVD name, rather than the class skips
# the emulator's other windows: a 1x1 placeholder, a 100x30 stub and the tool
# strip.
AVD_NAME="${AVD_NAME:-strawdroid}"
TITLE="Android Emulator - ${AVD_NAME}"

# feh paints the wallpaper as a pixmap of the screen size at that moment, and
# after a resize the new area stays white and the image stretched. It is
# repainted only when the size changes, so a background somebody set by hand
# lasts until the next resize.
letzte=""
neu_zeichnen() {
    xsetroot -solid '#161616' 2>/dev/null || true
    if command -v feh >/dev/null 2>&1 && [ -f /usr/local/share/strawdroid-wallpaper.png ]; then
        feh --no-fehbg --bg-max --image-bg '#161616' \
            /usr/local/share/strawdroid-wallpaper.png 2>/dev/null || true
    fi
}

while :; do
    read -r sw sh <<<"$(xdpyinfo | awk '/dimensions:/ { split($2, d, "x"); print d[1], d[2] }')"
    if [ -n "${sw}" ] && [ "${sw}x${sh}" != "${letzte}" ]; then
        [ -n "${letzte}" ] && echo "[svc-window-keeper] screen is now ${sw}x${sh}, repainting the background"
        letzte="${sw}x${sh}"
        neu_zeichnen
    fi

    id="$(wmctrl -l | awk -v t="${TITLE}" 'index($0, t) { print $1; exit }')"
    if [ -n "${id}" ]; then
        geo="$(xwininfo -id "${id}" 2>/dev/null)"
        w="$(echo "${geo}" | awk '/Width:/  { print $2 }')"
        h="$(echo "${geo}" | awk '/Height:/ { print $2 }')"
        x="$(echo "${geo}" | awk '/Absolute upper-left X:/ { print $NF }')"
        y="$(echo "${geo}" | awk '/Absolute upper-left Y:/ { print $NF }')"

        if [ -n "${w}" ] && [ -n "${sw}" ]; then
            # A window larger than the screen is pinned to the top left rather
            # than centred, so its top stays visible.
            if [ "${x}" -lt 0 ] || [ "${y}" -lt 0 ] \
               || [ "$((x + w))" -gt "${sw}" ] || [ "$((y + h))" -gt "${sh}" ]; then
                nx=$(( (sw - w) / 2 )); [ "${nx}" -lt 0 ] && nx=0
                ny=$(( (sh - h) / 2 )); [ "${ny}" -lt 0 ] && ny=0
                echo "[svc-window-keeper] moving the phone from ${x},${y} to ${nx},${ny} on a ${sw}x${sh} screen"
                wmctrl -i -r "${id}" -e "0,${nx},${ny},-1,-1" 2>/dev/null || true
            fi
        fi
    fi
    sleep 2
done
