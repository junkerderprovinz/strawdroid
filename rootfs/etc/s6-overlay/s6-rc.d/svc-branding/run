#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# -----------------------------------------------------------------------------
# svc-branding - the mark on the phone itself
# -----------------------------------------------------------------------------
# Puts the StrawKnight wallpaper behind the launcher and makes the app icons
# monochrome, once per device, on the first boot of a fresh AVD.
#
# WHY THIS COPIES FILES INSTEAD OF CALLING A COMMAND. Android has no way to set
# a wallpaper from a shell: `cmd wallpaper` knows dimming and nothing else, and
# the only code path that reaches WallpaperManager.setBitmap is the "Wallpaper
# and style" screen. So the picture was set there once by hand, the three files
# the system wrote were kept, and this service copies them back. The bytes in
# defaults/android are the system's own, not ours: the file the picker wrote is
# re-encoded and matched to the crop rectangles in wallpaper_info.xml, so
# shipping our source PNG under that name would pair a picture with a crop that
# was computed for a different one.
#
# That ties this to the system image, and that is acceptable here because the
# Dockerfile pins one: android-36, google_apis, x86_64. If that pin moves, set
# the wallpaper by hand once on the new image and refresh these three files.
#
# A LONGRUN, NOT A ONESHOT, for the same reason svc-strawknight-ready is one:
# the work cannot start until Android has booted, which takes minutes on a cold
# first start, and a oneshot that blocks the dependency chain that long would
# hold up every service behind it. It does its work and then sleeps.
#
# ONCE PER DEVICE, not once per start. The marker lives in /config, beside the
# AVD it belongs to, so a new AVD gets the branding and a person who changed
# their own wallpaper afterwards keeps their choice.
# -----------------------------------------------------------------------------
QUELLE=/defaults/android
MARKE=/config/.strawknight-branding
ZIEL=/data/system/users/0

# svc-strawknight-ready holds its READY line until this file appears, so that
# the framework restart below does not happen in front of somebody who has just
# been told the rig is ready. It is set on EVERY path out of here, the ones
# where nothing was done included: a service that gives up silently would hold
# the READY line for its full timeout and look like a hang.
fertig() {
    touch /run/strawknight-branding-done
    exec sleep infinity
}

if [[ -f "${MARKE}" ]]; then
    fertig
fi

warte_auf_start() {
    for _ in $(seq 1 300); do
        if [[ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r\n')" == "1" ]]; then
            return 0
        fi
        sleep 2
    done
    return 1
}

adb wait-for-device >/dev/null 2>&1
if ! warte_auf_start; then
    echo "[svc-branding] Android ist nicht hochgekommen, nichts geaendert"
    fertig
fi

# adb root is what makes the rest possible at all. On a production build it
# fails and the service says so rather than leaving a trail of denied writes.
if ! adb root >/dev/null 2>&1 || ! warte_auf_start; then
    echo "[svc-branding] adb root nicht moeglich, Hintergrundbild bleibt Standard"
    fertig
fi

echo "[svc-branding] Hintergrundbild und einfarbige Symbole werden gesetzt"

# wallpaper and wallpaper_orig are the same bytes on the device, so one file
# ships and is written twice.
for f in wallpaper wallpaper_orig; do
    adb push "${QUELLE}/wallpaper" "/data/local/tmp/${f}" >/dev/null 2>&1
    adb shell cp "/data/local/tmp/${f}" "${ZIEL}/${f}"
    adb shell rm -f "/data/local/tmp/${f}"
done
adb push "${QUELLE}/wallpaper_info.xml" /data/local/tmp/wallpaper_info.xml >/dev/null 2>&1
adb shell cp /data/local/tmp/wallpaper_info.xml "${ZIEL}/wallpaper_info.xml"
adb shell rm -f /data/local/tmp/wallpaper_info.xml

adb shell chown system:system "${ZIEL}/wallpaper" "${ZIEL}/wallpaper_orig" "${ZIEL}/wallpaper_info.xml"
adb shell chmod 600 "${ZIEL}/wallpaper" "${ZIEL}/wallpaper_info.xml"
adb shell chmod 700 "${ZIEL}/wallpaper_orig"
# Without the wallpaper_file context the service cannot read the picture and
# falls back to the stock one, silently and with nothing in the log.
adb shell restorecon "${ZIEL}/wallpaper" "${ZIEL}/wallpaper_orig" \
                     "${ZIEL}/wallpaper_info.xml" >/dev/null 2>&1

# Three keys, and each one fixes a different half-measure.
#
# themed_icon alone makes the icons ONE colour, not white: the colour is
# derived from the wallpaper, and on this picture it first landed on pink.
#
# MONOCHROMATIC drops the saturation but not the hue, because the seed is still
# the wallpaper. The result was a cool blue-grey, which is not what anybody
# means by white.
#
# color_source=preset with a white system_palette takes the wallpaper out of it
# altogether, and only then are the icons actually neutral.
JSON='{"_applied_timestamp":2,"android.theme.customization.color_source":"preset","android.theme.customization.system_palette":"FFFFFF","android.theme.customization.accent_color":"FFFFFF","android.theme.customization.theme_style":"MONOCHROMATIC","android.theme.customization.color_both":"1","android.theme.customization.themed_icon":"1"}'
adb shell "settings put secure theme_customization_overlay_packages '${JSON}'"

# The launcher puts a predicted app on the home screen, above the dock, and on
# a fresh device that is Google Photos. It is not a row in the launcher
# database, so deleting it there does nothing: it is drawn from the prediction
# service and comes straight back. Switching that service off is what removes
# it, and on a rig whose job is to run somebody's app under test, on-device
# suggestions are noise rather than a feature.
adb shell pm disable-user --user 0 com.google.android.as >/dev/null 2>&1 || true

# The launcher keeps its preferences in memory and writes them out when it
# stops, so it has to be stopped before the file is touched.
PREFS=/data/data/com.google.android.apps.nexuslauncher/shared_prefs/com.android.launcher3.prefs.xml
adb shell am force-stop com.google.android.apps.nexuslauncher >/dev/null 2>&1
sleep 2
adb shell "grep -q themed_icons ${PREFS} 2>/dev/null || sed -i 's#</map>#    <boolean name=\"themed_icons\" value=\"true\" />\n</map>#' ${PREFS}" >/dev/null 2>&1

# The framework reads all of this at startup, so it gets one. This costs about
# forty seconds and happens exactly once in the life of an AVD.
adb shell stop
sleep 3
adb shell start
if warte_auf_start; then
    echo "[svc-branding] gesetzt"
    touch "${MARKE}"
else
    echo "[svc-branding] Android kam nach dem Neustart nicht wieder hoch"
fi

fertig
