#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Puts the StrawDroid wallpaper behind the launcher and makes the app icons
# monochrome, once, on the first boot of a fresh AVD.
#
# Android cannot set a wallpaper from a shell: `cmd wallpaper` only knows
# dimming, and WallpaperManager.setBitmap is reachable only from the "Wallpaper
# and style" screen. So the wallpaper was set there once by hand and the three
# files the system wrote are copied back. They are the system's own bytes, with
# the picture re-encoded to match the crop rectangles in wallpaper_info.xml, so
# they belong to the pinned system image (android-36, google_apis, x86_64). If
# that pin moves, set the wallpaper by hand on the new image and refresh them.
#
# A longrun rather than a oneshot, like svc-strawdroid-ready: it has to wait
# minutes for Android to boot, and a oneshot would hold up every service behind
# it. The marker lives in /config beside the AVD, so a new AVD gets the branding
# and a wallpaper somebody chose afterwards stays.
SRC=/defaults/android
APK=/defaults/apk
MARKER=/config/.strawdroid-branding
DEST=/data/system/users/0

# svc-strawdroid-ready holds its READY line until this file exists, so the
# framework restart below does not happen right after it. Every exit path sets
# it; otherwise the READY line would wait out its full timeout.
finish() {
    touch /run/strawdroid-branding-done
    exec sleep infinity
}

if [[ -f "${MARKER}" ]]; then
    finish
fi

wait_for_boot() {
    for _ in $(seq 1 300); do
        if [[ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r\n')" == "1" ]]; then
            return 0
        fi
        sleep 2
    done
    return 1
}

adb wait-for-device >/dev/null 2>&1
if ! wait_for_boot; then
    echo "[svc-branding] Android did not come up, nothing changed"
    finish
fi

# adb root fails on a production build, and without it every write below would
# be denied.
if ! adb root >/dev/null 2>&1 || ! wait_for_boot; then
    echo "[svc-branding] adb root failed, the wallpaper stays the default"
    finish
fi

echo "[svc-branding] setting the wallpaper and monochrome icons"

# wallpaper and wallpaper_orig are the same bytes on the device.
for f in wallpaper wallpaper_orig; do
    adb push "${SRC}/wallpaper" "/data/local/tmp/${f}" >/dev/null 2>&1
    adb shell cp "/data/local/tmp/${f}" "${DEST}/${f}"
    adb shell rm -f "/data/local/tmp/${f}"
done
adb push "${SRC}/wallpaper_info.xml" /data/local/tmp/wallpaper_info.xml >/dev/null 2>&1
adb shell cp /data/local/tmp/wallpaper_info.xml "${DEST}/wallpaper_info.xml"
adb shell rm -f /data/local/tmp/wallpaper_info.xml

adb shell chown system:system "${DEST}/wallpaper" "${DEST}/wallpaper_orig" "${DEST}/wallpaper_info.xml"
adb shell chmod 600 "${DEST}/wallpaper" "${DEST}/wallpaper_info.xml"
adb shell chmod 700 "${DEST}/wallpaper_orig"
# Without the wallpaper_file context the service cannot read the picture and
# silently falls back to the stock one.
adb shell restorecon "${DEST}/wallpaper" "${DEST}/wallpaper_orig" \
                     "${DEST}/wallpaper_info.xml" >/dev/null 2>&1

# themed_icon alone tints the icons with a colour derived from the wallpaper,
# and MONOCHROMATIC still keeps that hue. Only color_source=preset with a white
# system_palette makes them neutral.
JSON='{"_applied_timestamp":2,"android.theme.customization.color_source":"preset","android.theme.customization.system_palette":"FFFFFF","android.theme.customization.accent_color":"FFFFFF","android.theme.customization.theme_style":"MONOCHROMATIC","android.theme.customization.color_both":"1","android.theme.customization.themed_icon":"1"}'
adb shell "settings put secure theme_customization_overlay_packages '${JSON}'"

# The predicted app above the dock comes from the prediction service, not the
# launcher database, so disabling the service is the only way to remove it.
adb shell pm disable-user --user 0 com.google.android.as >/dev/null 2>&1 || true

# In light mode themed icons are dark glyphs on pale circles, the opposite of
# what the wallpaper was drawn for.
adb shell cmd uimode night yes >/dev/null 2>&1 || true

# The launcher keeps its preferences and layout in memory and writes both out
# when it stops, so it is stopped before either is touched.
PREFS=/data/data/com.google.android.apps.nexuslauncher/shared_prefs/com.android.launcher3.prefs.xml
DB=/data/data/com.google.android.apps.nexuslauncher/databases/launcher_4_by_5.db
adb shell am force-stop com.google.android.apps.nexuslauncher >/dev/null 2>&1
sleep 2
adb shell "grep -q themed_icons ${PREFS} 2>/dev/null || sed -i 's#</map>#    <boolean name=\"themed_icons\" value=\"true\" />\n</map>#' ${PREFS}" >/dev/null 2>&1

# Clears Gmail, Photos and YouTube from the home screen. Container -100 is the
# workspace and -101 the dock, which keeps its apps.
adb shell "sqlite3 ${DB} 'delete from favorites where container = -100;'" >/dev/null 2>&1 || true

# Lawnchair keeps its settings in a DataStore and a launcher database with no
# command-line way in, so, as with the wallpaper, they were made once by hand
# and the four files are restored.
if [[ -f "${APK}/lawnchair.apk" ]]; then
    echo "[svc-branding] launcher and icons"
    adb install -r -g "${APK}/lawnchair.apk" >/dev/null 2>&1
    adb install -r "${APK}/arcticons.apk" >/dev/null 2>&1

    if adb shell pm list packages 2>/dev/null | grep -q "app.lawnchair"; then
        # A fresh install has no databases directory until the app first
        # writes, so Lawnchair is started once to create it with the right
        # owner and SELinux context. It is started by its activity, because the
        # HOME key would still open the stock launcher.
        adb shell am start -n app.lawnchair/app.lawnchair.LawnchairLauncher >/dev/null 2>&1
        for _ in $(seq 1 30); do
            adb shell "test -d /data/data/app.lawnchair/databases" >/dev/null 2>&1 && break
            sleep 2
        done
        adb shell am force-stop app.lawnchair >/dev/null 2>&1
        sleep 3

        owner="$(adb shell stat -c '%U:%G' /data/data/app.lawnchair 2>/dev/null | tr -d '\r\n')"

        # The settings live in files/datastore/preferences.preferences_pb, not
        # in databases/preferences as the name suggests. The SQLite -wal and
        # -shm files are removed rather than shipped, because side files out of
        # step with the main file would roll it back.
        copied=0
        total=0
        restore_one() {
            local file="$1" dest="$2"
            [[ -f "${SRC}/lawnchair/${file}" ]] || return 0
            total=$((total + 1))
            adb push "${SRC}/lawnchair/${file}" "/data/local/tmp/${file}" >/dev/null 2>&1
            if adb shell cp "/data/local/tmp/${file}" "${dest}/${file}" >/dev/null 2>&1; then
                copied=$((copied + 1))
                [[ -n "${owner}" ]] && adb shell chown "${owner}" "${dest}/${file}"
                adb shell restorecon "${dest}/${file}" >/dev/null 2>&1
            fi
            adb shell rm -f "/data/local/tmp/${file}"
        }

        adb shell mkdir -p /data/data/app.lawnchair/files/datastore >/dev/null 2>&1
        restore_one preferences.preferences_pb          /data/data/app.lawnchair/files/datastore
        restore_one launcher_5_4_4.db                   /data/data/app.lawnchair/databases
        restore_one com.android.launcher3.prefs.xml     /data/data/app.lawnchair/shared_prefs
        restore_one com.android.launcher3.device.prefs.xml /data/data/app.lawnchair/shared_prefs

        adb shell rm -f /data/data/app.lawnchair/databases/preferences-wal \
                        /data/data/app.lawnchair/databases/preferences-shm \
                        /data/data/app.lawnchair/databases/launcher_5_4_4.db-journal >/dev/null 2>&1

        if [[ "${copied}" -ne "${total}" ]]; then
            echo "[svc-branding] Lawnchair: only ${copied} of ${total} settings files arrived"
        fi
    else
        echo "[svc-branding] Lawnchair did not install, the Pixel Launcher stays"
    fi
fi

# The framework reads all of this at startup, so it is restarted once in the
# life of an AVD, which takes about forty seconds.
adb shell stop
sleep 3
adb shell start
if wait_for_boot; then
    # The default launcher is set only after the framework restart, which would
    # otherwise undo it. Right after boot_completed the package manager still
    # answers Success and then drops the setting, so it is set and checked
    # until it holds. The full class name is needed because the short form
    # with a leading dot is not accepted everywhere.
    home=""
    for _ in $(seq 1 12); do
        adb shell cmd package set-home-activity \
            app.lawnchair/app.lawnchair.LawnchairLauncher >/dev/null 2>&1
        sleep 5
        home="$(adb shell cmd package resolve-activity -c android.intent.category.HOME \
                    -a android.intent.action.MAIN 2>/dev/null | grep -m1 packageName | tr -d ' \r')"
        [[ "${home}" == *"app.lawnchair"* ]] && break
    done

    if [[ "${home}" == *"app.lawnchair"* ]]; then
        echo "[svc-branding] Lawnchair with Arcticons is the home screen"
    else
        echo "[svc-branding] the home screen stayed ${home:-unknown}, Lawnchair did not take"
    fi
    adb shell input keyevent KEYCODE_HOME >/dev/null 2>&1

    echo "[svc-branding] done"
    touch "${MARKER}"
else
    echo "[svc-branding] Android did not come back up after the restart"
fi

finish
