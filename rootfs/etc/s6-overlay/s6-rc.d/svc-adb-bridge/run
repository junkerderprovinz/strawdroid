#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# The emulator's adb daemon binds to 127.0.0.1 only, so from outside the port
# looks open and `adb connect` times out. This forwards the container's own
# address on 5555 to it, which lets Android Studio run and debug against the
# container like a phone on a cable.
#
# It binds the container's address rather than 0.0.0.0, because 0.0.0.0:5555
# includes 127.0.0.1:5555, which the emulator already holds. fork lets Android
# Studio and a terminal attach at the same time.
ADB_DEVICE_PORT="${ADB_DEVICE_PORT:-5555}"

# `hostname -i` can return the loopback address, several addresses or nothing,
# depending on the container's hosts file; the source address of the outbound
# route is reliable.
own_ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src") print $(i+1); exit}')"
if [ -z "${own_ip}" ]; then
    echo "[svc-adb-bridge] could not work out this container's own address; adb will only be reachable from inside" >&2
    exec sleep infinity
fi

# Against a closed port socat would accept outside connections and then drop
# each one.
for _ in $(seq 1 300); do
    if (exec 3<>/dev/tcp/127.0.0.1/"${ADB_DEVICE_PORT}") 2>/dev/null; then
        exec 3>&- 3<&-
        break
    fi
    sleep 2
done

echo "[svc-adb-bridge] forwarding ${own_ip}:${ADB_DEVICE_PORT} to 127.0.0.1:${ADB_DEVICE_PORT}"
exec socat "tcp-listen:${ADB_DEVICE_PORT},fork,reuseaddr,bind=${own_ip}" \
           "tcp:127.0.0.1:${ADB_DEVICE_PORT}"
