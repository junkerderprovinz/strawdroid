#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Prints the "READY" banner as the last block of the container log once both the
# WebUI serves and Android has finished booting, and otherwise names which of
# the two is missing. A desktop over a still-booting emulator is not usable yet.
FLAG="/run/strawdroid-ready.printed"

# /run is a tmpfs, so the banner prints once per container start.
if [[ -f "${FLAG}" ]]; then
    exec sleep infinity
fi

web=0
for _ in $(seq 1 150); do
    if (exec 3<>/dev/tcp/127.0.0.1/3000) 2>/dev/null; then
        exec 3>&- 3<&-
        web=1
        break
    fi
    sleep 2
done

# A cold first boot creates the data partition and takes minutes.
booted=0
for _ in $(seq 1 300); do
    if [[ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r\n')" == "1" ]]; then
        booted=1
        break
    fi
    sleep 2
done

# On a fresh AVD svc-branding restarts the Android framework at about this
# point, which right after a READY line would look like a crash. The wait is
# bounded so the banner still arrives if svc-branding never runs.
if [[ "${booted}" -eq 1 ]]; then
    for _ in $(seq 1 90); do
        [[ -f /run/strawdroid-branding-done ]] && break
        sleep 2
    done
fi

release="unknown"
if [[ "${booted}" -eq 1 ]]; then
    release="$(adb shell getprop ro.build.version.release 2>/dev/null | tr -d '\r\n')"
    sdk="$(adb shell getprop ro.build.version.sdk 2>/dev/null | tr -d '\r\n')"
    [[ -n "${sdk}" ]] && release="${release} (API ${sdk})"
fi

own_ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src") print $(i+1); exit}')"
[[ -z "${own_ip}" ]] && own_ip="this container"

/usr/local/bin/print-banner.sh "StrawDroid" "Android ${release} on Selkies" 2>/dev/null || true

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

if [[ "${web}" -eq 1 && "${booted}" -eq 1 ]]; then
    echo -e "  ${GREEN}✓ STRAWDROID IS READY${NC} - Android ${release}"
    echo "    Screen:  https://${own_ip}:${CUSTOM_HTTPS_PORT:-3001}/"
    echo "    Deploy:  adb connect ${own_ip}:${ADB_DEVICE_PORT:-5555}"
    echo "    Doze:    adb -s ${own_ip}:${ADB_DEVICE_PORT:-5555} shell dumpsys deviceidle force-idle"
elif [[ "${web}" -eq 1 ]]; then
    # A phone that never booted almost always means a missing /dev/kvm.
    echo -e "  ${RED}✗ STRAWDROID IS NOT READY${NC} - the desktop serves but Android never finished booting"
    echo "    The usual cause is a missing --device=/dev/kvm on this container; check the log above."
else
    echo -e "  ${RED}✗ STRAWDROID IS NOT READY${NC} - the WebUI never answered, check the log above"
fi
echo ""

touch "${FLAG}"
# A longrun that exits would be restarted by s6 and print the banner again.
exec sleep infinity
