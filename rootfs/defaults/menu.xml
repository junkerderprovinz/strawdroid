<?xml version="1.0" encoding="UTF-8"?>

<!-- The base image's init-selkies-config copies this to
     /config/.config/openbox/menu.xml on first boot only, so a change here
     reaches a fresh /config and an existing one keeps its menu. -->

<openbox_menu xmlns="http://openbox.org/"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://openbox.org/
                file:///usr/share/openbox/menu.xsd">

<menu id="root-menu" label="StrawDroid">
  <item label="Terminal">
    <action name="Execute"><execute>xterm</execute></action>
  </item>
  <separator />
  <item label="Reconfigure">
    <action name="Reconfigure" />
  </item>
  <item label="Restart">
    <action name="Restart" />
  </item>
</menu>

</openbox_menu>
