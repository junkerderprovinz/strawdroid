#!/usr/bin/env bash
# sk: short forms of the adb calls this rig needs from a terminal. APKs come
# from the share, mounted read-only at /share, so anything dropped into it from
# the network can be installed without leaving the browser.
set -euo pipefail

SHARE="${SK_SHARE:-/share}"
# The share is read-only, so screenshots, recordings and captures go here.
OUT="${SK_OUT:-/config/captures}"
SEED=/defaults/seed
# svc-emulator starts the emulator with this file as the back camera's picture
# and the emulator reads it again each time an app opens the camera.
CAMERA=/config/camera/back.png
PCAPDROID=com.emanuelef.remote_capture
NETLOG=strawdroid-netlog.pcap

usage() {
    cat <<'EOF'
sk install <file.apk>     install an APK, replacing any earlier build of it
sk list                   the APKs on the mounted share, newest first
sk push <file|dir> [dest] copy files into the device's shared storage
sk seed                   test contacts, photos with GPS, music with BPM tags,
                          a video, documents, a score, a song, a GPS track, a
                          calendar event and barcode pictures on the device
sk camera <code|file>     what the back camera sees: qr-text, qr-url, qr-wifi,
                          qr-otp, qr-contact, ean13, code128 or a picture
sk doze on|off            force the device into deep idle, or release it
sk sms <number> <text>    an incoming SMS from that number
sk call <number>          an incoming call from that number
sk geo <lat> <lon> [alt]  put the device at that position, altitude in metres
sk route <file.gpx> [--kmh n] [--speedup n] [--loop]
                          drive the GPS along a track, one fix per second;
                          test-track is the Graz loop from sk seed
sk pin <code>|off         set or remove the screen lock PIN
sk finger enroll          add a fingerprint (sets PIN 1357 if there is none)
sk finger touch [id]      touch the sensor with that finger, 1 unless given
sk sensor [name values]   list the sensors, or set one, e.g. pressure 950
sk home pixel|lawnchair   the home screen app; widgets show only on pixel
sk expose <port>          reach a port the device listens on from the network
sk expose off <port>      stop that
sk lang <tag>             switch the system language, e.g. de-AT or en-US
sk dark on|off            dark or light theme
sk snap save|load|rm <name>
sk snap list              save the whole device and return to it in seconds
sk reset                  load the snapshot called "clean"
sk netlog start <package> record which hosts an app talks to
sk netlog stop            stop and list them
sk shot [name]            a screenshot
sk record [seconds]       a screen recording, 30 seconds unless given
sk shell [...]            a shell on the device, or one command on it

Paths are taken relative to the share when they are not absolute, so
"sk install arrowloop.apk" finds /share/arrowloop.apk. Screenshots,
recordings and network logs are saved under /config/captures.
EOF
}

# A bare name means "on the share", because that is where things arrive.
resolve() {
    case "$1" in
        /*) printf '%s' "$1" ;;
        *)  printf '%s' "${SHARE}/$1" ;;
    esac
}

booted() {
    [ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r\n')" = "1" ]
}

require_device() {
    if ! booted; then
        echo "The device is not up yet. It takes about a minute from a cold start." >&2
        exit 1
    fi
}

wait_for_boot() {
    for _ in $(seq 1 120); do
        booted && return 0
        sleep 2
    done
    echo "The device did not come back up." >&2
    exit 1
}

# Until the media scanner sees a file, the picker and the gallery do not show it.
scan() {
    adb shell am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE \
        -d "file://$1" >/dev/null 2>&1 || true
}

# PCAPdroid asks before anyone else may start or stop a capture, and Android
# asks once before any app may run a VPN. Both dialogs are confirmed here.
confirm_capture() {
    local tapped=0 bounds x1 y1 x2 y2
    for _ in $(seq 1 10); do
        sleep 1
        bounds="$(adb exec-out uiautomator dump /dev/tty 2>/dev/null \
            | grep -oE 'resource-id="(com\.emanuelef\.remote_capture:id/allow_btn|android:id/button1)"[^>]*bounds="\[[0-9]+,[0-9]+\]\[[0-9]+,[0-9]+\]"' \
            | grep -oE '\[[0-9]+,[0-9]+\]\[[0-9]+,[0-9]+\]' | head -n 1)" || true
        if [ -z "${bounds}" ]; then
            [ "${tapped}" -eq 1 ] && return 0
            continue
        fi
        read -r x1 y1 x2 y2 <<<"$(tr '[],' '   ' <<<"${bounds}")"
        adb shell input tap $(((x1 + x2) / 2)) $(((y1 + y2) / 2))
        tapped=1
    done
}

put() {
    local dir="/sdcard/$1/StrawDroid" f
    shift
    adb shell mkdir -p "${dir}"
    for f in "$@"; do
        adb push "${f}" "${dir}/" >/dev/null 2>&1
        scan "${dir}/$(basename "${f}")"
    done
}

contact() {
    local name="$1" phone="$2" email="$3" id
    if adb shell content query --uri content://com.android.contacts/contacts \
        --projection display_name 2>/dev/null | grep -q "display_name=${name}\$"; then
        return 0
    fi
    adb shell content insert --uri content://com.android.contacts/raw_contacts \
        --bind account_type:n: --bind account_name:n:
    id="$(adb shell content query --uri content://com.android.contacts/raw_contacts \
        --projection _id --sort "'_id DESC'" | head -n 1 | sed -n 's/.*_id=\([0-9]*\).*/\1/p')"
    adb shell content insert --uri content://com.android.contacts/data --bind "raw_contact_id:i:${id}" \
        --bind mimetype:s:vnd.android.cursor.item/name --bind "data1:s:'${name}'"
    adb shell content insert --uri content://com.android.contacts/data --bind "raw_contact_id:i:${id}" \
        --bind mimetype:s:vnd.android.cursor.item/phone_v2 --bind "data1:s:${phone}" --bind data2:i:2
    adb shell content insert --uri content://com.android.contacts/data --bind "raw_contact_id:i:${id}" \
        --bind mimetype:s:vnd.android.cursor.item/email_v2 --bind "data1:s:${email}" --bind data2:i:1
}

fingerprints() {
    adb shell dumpsys fingerprint 2>/dev/null | grep -oE '"count":[0-9]+' | head -n 1 | cut -d: -f2
}

# The enrolment screens differ by Android version and language, and their buttons
# carry no ids, but the button that moves on is always the right one in the footer.
enroll_finger() {
    local before width height bounds x1 y1 x2 y2
    if [ ! -s /config/.sk-pin ]; then
        adb shell locksettings set-pin 1357 >/dev/null
        printf '1357' >/config/.sk-pin
    fi
    before="$(fingerprints)"
    # A half-finished enrolment brought back to the front skips the PIN screen.
    adb shell am force-stop com.android.settings
    adb shell am start -a android.settings.FINGERPRINT_ENROLL >/dev/null
    sleep 3
    adb shell input text "$(cat /config/.sk-pin)"
    adb shell input keyevent KEYCODE_ENTER
    read -r width height <<<"$(adb shell wm size | grep -oE '[0-9]+x[0-9]+' | tail -n 1 | tr x ' ')"
    for _ in $(seq 1 40); do
        sleep 2
        if [ "$(fingerprints)" -gt "${before:-0}" ]; then
            adb shell input keyevent KEYCODE_HOME
            echo "Fingerprint 1 is enrolled. Unlock with: sk finger touch"
            return 0
        fi
        bounds="$(adb exec-out uiautomator dump /dev/tty 2>/dev/null \
            | grep -oE 'class="android.widget.Button"[^>]*clickable="true"[^>]*bounds="\[[0-9]+,[0-9]+\]\[[0-9]+,[0-9]+\]"' \
            | grep -oE '\[[0-9]+,[0-9]+\]\[[0-9]+,[0-9]+\]' | tr '[],' '   ' \
            | awk -v w="${width}" -v h="${height}" '$1 > w / 2 && $2 > h * 3 / 4' \
            | sort -n -k1 | tail -n 1)" || true
        if [ -n "${bounds}" ]; then
            read -r x1 y1 x2 y2 <<<"${bounds}"
            adb shell input tap $(((x1 + x2) / 2)) $(((y1 + y2) / 2))
            continue
        fi
        adb emu finger touch 1 >/dev/null
        sleep 0.5
        adb emu finger remove 1 >/dev/null 2>&1 || true
    done
    echo "Enrolment did not finish; look at the screen." >&2
    return 1
}

cmd="${1:-}"
shift || true

case "${cmd}" in
install)
    [ $# -ge 1 ] || { usage >&2; exit 2; }
    apk="$(resolve "$1")"
    [ -f "${apk}" ] || { echo "No such file: ${apk}" >&2; exit 1; }
    require_device
    # -r keeps the existing app's data, so a new build is tested against the
    # state the last one left. -d allows a downgrade, since version codes go
    # backwards during development.
    adb install -r -d "${apk}"
    ;;
list)
    if [ ! -d "${SHARE}" ]; then
        echo "Nothing is mounted at ${SHARE}. Add the share to this container to use it." >&2
        exit 1
    fi
    # Collected first so an empty share gets a message instead of no output.
    found="$(find "${SHARE}" -maxdepth 2 -type f -iname '*.apk' \
        -printf '%T@ %TY-%Tm-%Td %TH:%TM  %10s  %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-)"
    if [ -z "${found}" ]; then
        echo "No APKs under ${SHARE}. Drop one into that share and run this again."
    else
        printf '%s\n' "${found}"
    fi
    ;;
push)
    [ $# -ge 1 ] || { usage >&2; exit 2; }
    src="$(resolve "$1")"
    # The SAF picker shows Download without a tree grant.
    dest="${2:-/sdcard/Download/}"
    [ -e "${src}" ] || { echo "No such file or folder: ${src}" >&2; exit 1; }
    require_device
    adb push "${src}" "${dest}"
    scan "${dest}"
    echo "Pushed to ${dest}"
    ;;
seed)
    require_device
    put Pictures "${SEED}"/photo-*.jpg
    put Music "${SEED}"/click-*.mp3
    put Movies "${SEED}"/test-pattern.mp4
    put Documents "${SEED}"/test-document.pdf "${SEED}"/test-note.txt "${SEED}"/test-table.csv \
        "${SEED}"/test-score.musicxml "${SEED}"/test-song.cho "${SEED}"/test-track.gpx "${SEED}"/test-event.ics
    put Pictures "${SEED}"/codes/*.png
    # 555-0100 to 555-0199 are set aside for fiction, so these reach nobody.
    contact "Anna Gruber" "+12015550101" "anna.gruber@example.org"
    contact "Bernd Müller" "+12015550102" "bernd.mueller@example.org"
    contact "Chiara Rossi" "+12015550103" "chiara.rossi@example.org"
    echo "Seeded: 3 contacts, 3 photos with GPS (Pictures/StrawDroid), 3 click tracks at"
    echo "90, 120 and 172 BPM (Music/StrawDroid), a video (Movies/StrawDroid), a PDF, a"
    echo "text file, a CSV, a MusicXML score, a ChordPro song, a GPX track and a calendar"
    echo "event (Documents/StrawDroid), and QR codes and barcodes (Pictures/StrawDroid)."
    ;;
camera)
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    if [ -f "${SEED}/codes/$1.png" ]; then
        picture="${SEED}/codes/$1.png"
    else
        picture="$(resolve "$1")"
    fi
    [ -f "${picture}" ] || { echo "No code called $1 and no such file: ${picture}" >&2; exit 1; }
    mkdir -p "$(dirname "${CAMERA}")"
    cp "${picture}" "${CAMERA}"
    echo "The back camera shows $(basename "${picture}") the next time an app opens it."
    echo "Through the camera only QR codes are read; import a barcode picture instead."
    ;;
doze)
    require_device
    case "${1:-}" in
        on)
            # A charging device refuses to go idle while force-idle still
            # reports success.
            adb shell dumpsys battery unplug >/dev/null
            adb shell dumpsys deviceidle force-idle
            ;;
        off)
            adb shell dumpsys deviceidle unforce >/dev/null
            adb shell dumpsys battery reset >/dev/null
            echo "Released. The device is charging again."
            ;;
        *) usage >&2; exit 2 ;;
    esac
    ;;
sms)
    [ $# -ge 2 ] || { usage >&2; exit 2; }
    require_device
    number="$1"
    shift
    adb emu sms send "${number}" "$*"
    ;;
call)
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    require_device
    adb emu gsm call "$1"
    ;;
geo)
    [ $# -eq 2 ] || [ $# -eq 3 ] || { usage >&2; exit 2; }
    require_device
    # The console takes longitude first, the other way round from how a
    # position is usually written.
    adb emu geo fix "$2" "$1" ${3:+"$3"} >/dev/null
    ;;
route)
    [ $# -ge 1 ] || { usage >&2; exit 2; }
    require_device
    track="$1"
    shift
    [ "${track}" = test-track ] && track="${SEED}/test-track.gpx"
    track="$(resolve "${track}")"
    [ -f "${track}" ] || { echo "No such file: ${track}" >&2; exit 1; }
    exec python3 /usr/local/lib/strawdroid/gpx-route.py "${track}" "$@"
    ;;
pin)
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    require_device
    current="$(cat /config/.sk-pin 2>/dev/null || true)"
    if [ "$1" = off ]; then
        adb shell locksettings clear ${current:+--old "${current}"}
        rm -f /config/.sk-pin
    else
        adb shell locksettings set-pin ${current:+--old "${current}"} "$1"
        # locksettings needs the old PIN to change or clear it later.
        printf '%s' "$1" >/config/.sk-pin
    fi
    ;;
finger)
    require_device
    case "${1:-}" in
        touch)
            adb emu finger touch "${2:-1}" >/dev/null
            sleep 0.5
            adb emu finger remove "${2:-1}" >/dev/null 2>&1 || true
            ;;
        enroll) enroll_finger ;;
        *) usage >&2; exit 2 ;;
    esac
    ;;
sensor)
    require_device
    if [ $# -eq 0 ]; then
        adb emu sensor status | grep -v '^OK'
        exit 0
    fi
    [ $# -ge 2 ] || { usage >&2; exit 2; }
    name="$1"
    shift
    # The console wants several values joined by colons, e.g. acceleration 0:9.8:0.
    adb emu sensor set "${name}" "$(IFS=:; echo "$*")" | grep -v '^OK' || true
    adb emu sensor get "${name}" | grep -v '^OK'
    ;;
home)
    require_device
    case "${1:-}" in
        pixel) launcher=com.google.android.apps.nexuslauncher/.NexusLauncherActivity ;;
        lawnchair) launcher=app.lawnchair/.LawnchairLauncher ;;
        *) usage >&2; exit 2 ;;
    esac
    adb shell cmd package set-home-activity "${launcher}" >/dev/null
    adb shell input keyevent KEYCODE_HOME
    echo "The home screen is ${1} now."
    ;;
expose)
    require_device
    if [ "${1:-}" = off ]; then
        [ $# -eq 2 ] || { usage >&2; exit 2; }
        pkill -f "socat TCP-LISTEN:$2," || true
        adb emu redir del "tcp:$2" >/dev/null 2>&1 || true
        echo "Port $2 is closed again."
        exit 0
    fi
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    port="$1"
    address="$(hostname -i | cut -d' ' -f1)"
    # The emulator forwards only on the loopback address, so socat carries the
    # port to the container's own address, where other devices can reach it.
    adb emu redir add "tcp:${port}:${port}" >/dev/null
    setsid nohup socat "TCP-LISTEN:${port},fork,reuseaddr,bind=${address}" "TCP:127.0.0.1:${port}" \
        >/dev/null 2>&1 &
    echo "Port ${port} on the device is reachable at ${address}:${port}."
    ;;
lang)
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    require_device
    # Android 16 has no shell command for the system language. The property is
    # read when the framework starts, so it is restarted, which takes about
    # twenty seconds.
    adb root >/dev/null
    adb wait-for-device
    adb shell setprop persist.sys.locale "$1"
    # The flag stays set through a framework restart, and the wait below would
    # pass at once. system_server sets it again when it is ready.
    adb shell setprop sys.boot_completed 0
    adb shell stop
    adb shell start
    wait_for_boot
    echo "The system language is $(adb shell getprop persist.sys.locale | tr -d '\r')."
    ;;
dark)
    require_device
    case "${1:-}" in
        on) adb shell cmd uimode night yes ;;
        off) adb shell cmd uimode night no ;;
        *) usage >&2; exit 2 ;;
    esac
    ;;
snap)
    case "${1:-}" in
        list) adb emu avd snapshot list ;;
        save|load|rm)
            [ $# -eq 2 ] || { usage >&2; exit 2; }
            action="$1"
            [ "${action}" = rm ] && action=delete
            adb emu avd snapshot "${action}" "$2"
            if [ "${action}" = load ]; then
                # adb loses the device while the snapshot is restored.
                adb reconnect offline >/dev/null 2>&1 || true
                adb wait-for-device
            fi
            ;;
        *) usage >&2; exit 2 ;;
    esac
    ;;
reset)
    if ! adb emu avd snapshot list 2>/dev/null | grep -qw clean; then
        echo 'There is no snapshot called "clean". Set the device up, then run: sk snap save clean' >&2
        exit 1
    fi
    adb emu avd snapshot load clean
    adb reconnect offline >/dev/null 2>&1 || true
    adb wait-for-device
    ;;
netlog)
    require_device
    if ! adb shell pm path "${PCAPDROID}" >/dev/null 2>&1; then
        echo "PCAPdroid is not installed. It comes with TEST_TOOLS=true." >&2
        exit 1
    fi
    case "${1:-}" in
        start)
            [ $# -eq 2 ] || { usage >&2; exit 2; }
            adb shell rm -f "/sdcard/Download/PCAPdroid/${NETLOG}"
            adb shell am start -e action start -e pcap_dump_mode pcap_file \
                -e pcap_name "${NETLOG}" -e app_filter "$2" \
                -n "${PCAPDROID}/.activities.CaptureCtrl" >/dev/null
            confirm_capture
            echo "Recording $2. Use the app, then run: sk netlog stop"
            ;;
        stop)
            adb shell am start -e action stop \
                -n "${PCAPDROID}/.activities.CaptureCtrl" >/dev/null
            confirm_capture
            mkdir -p "${OUT}"
            file="${OUT}/netlog-$(date +%Y%m%d-%H%M%S).pcap"
            adb pull "/sdcard/Download/PCAPdroid/${NETLOG}" "${file}" >/dev/null 2>&1
            # PCAPdroid writes the pcap header only with the first packet.
            if [ ! -s "${file}" ]; then
                rm -f "${file}"
                echo "Nothing recorded: the app sent and received no packets."
                exit 0
            fi
            python3 /usr/local/lib/strawdroid/pcap-hosts.py "${file}"
            echo "Capture saved as ${file}"
            ;;
        *) usage >&2; exit 2 ;;
    esac
    ;;
shot)
    require_device
    mkdir -p "${OUT}"
    file="${OUT}/${1:-shot-$(date +%Y%m%d-%H%M%S)}.png"
    adb exec-out screencap -p >"${file}"
    echo "Saved ${file}"
    ;;
record)
    require_device
    seconds="${1:-30}"
    mkdir -p "${OUT}"
    file="${OUT}/record-$(date +%Y%m%d-%H%M%S).mp4"
    echo "Recording ${seconds} seconds..."
    adb shell screenrecord --time-limit "${seconds}" /sdcard/strawdroid-record.mp4
    adb pull /sdcard/strawdroid-record.mp4 "${file}" >/dev/null 2>&1
    adb shell rm -f /sdcard/strawdroid-record.mp4
    echo "Saved ${file}"
    ;;
shell)
    require_device
    adb shell "$@"
    ;;
*)
    usage
    [ -z "${cmd}" ] && exit 0 || exit 2
    ;;
esac
