#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# sk - the three things somebody does to this rig from a terminal
# -----------------------------------------------------------------------------
# It exists because all three are one adb invocation away and none of them is
# the invocation somebody remembers. `sk install foo.apk` beats looking up
# whether it was `adb install -r` or `-t` for the fourth time.
#
# The share is mounted READ-ONLY at /share (see the Unraid template), so an APK
# dropped into the download folder from anywhere on the network can be installed
# here without leaving the browser. Nothing in here can write to it: this rig
# runs unfinished code, and unfinished code has no business writing to a share
# full of everything else.
# -----------------------------------------------------------------------------
set -euo pipefail

SHARE="${SK_SHARE:-/share}"

usage() {
    cat <<'EOF'
sk install <file.apk>     install an APK, replacing any earlier build of it
sk list                   the APKs on the mounted share, newest first
sk push <file|dir> [dest] copy files INTO the device's shared storage
sk doze on|off            force the device into deep idle, or release it
sk shell [...]            a shell on the device, or one command on it

Paths are taken relative to the share when they are not absolute, so
"sk install arrowloop.apk" finds /share/arrowloop.apk.
EOF
}

# A bare name means "on the share", because that is where things arrive.
resolve() {
    case "$1" in
        /*) printf '%s' "$1" ;;
        *)  printf '%s' "${SHARE}/$1" ;;
    esac
}

require_device() {
    if [ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r\n')" != "1" ]; then
        echo "The device is not up yet. It takes about a minute from a cold start." >&2
        exit 1
    fi
}

cmd="${1:-}"
shift || true

case "${cmd}" in
install)
    [ $# -ge 1 ] || { usage >&2; exit 2; }
    apk="$(resolve "$1")"
    [ -f "${apk}" ] || { echo "No such file: ${apk}" >&2; exit 1; }
    require_device
    # -r replaces an existing install and KEEPS its data, which is what makes a
    # second build testable against the state the first one left behind. -d
    # allows a downgrade, because during development the version code goes
    # backwards more often than anybody admits.
    adb install -r -d "${apk}"
    ;;
list)
    if [ ! -d "${SHARE}" ]; then
        echo "Nothing is mounted at ${SHARE}. Add the share to this container to use it." >&2
        exit 1
    fi
    # Collected first and printed second, so "nothing there" can be SAID.
    # Piping straight to cut prints nothing on an empty share and returns
    # success, which reads as the command having failed silently.
    found="$(find "${SHARE}" -maxdepth 2 -type f -iname '*.apk' \
        -printf '%T@ %TY-%Tm-%Td %TH:%TM  %10s  %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-)"
    if [ -z "${found}" ]; then
        echo "No APKs under ${SHARE}. Drop one into that share and run this again."
    else
        printf '%s\n' "${found}"
    fi
    ;;
push)
    [ $# -ge 1 ] || { usage >&2; exit 2; }
    src="$(resolve "$1")"
    # Downloads by default: it is the one folder the SAF picker shows without
    # anybody having to grant a tree first, so files land where a test can
    # actually reach them.
    dest="${2:-/sdcard/Download/}"
    [ -e "${src}" ] || { echo "No such file or folder: ${src}" >&2; exit 1; }
    require_device
    adb push "${src}" "${dest}"
    # The media scanner is what makes a pushed file VISIBLE to the picker.
    # Without this the file is on the disk and absent from every chooser, which
    # looks like the push having silently failed.
    adb shell am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE \
        -d "file://${dest}" >/dev/null 2>&1 || true
    echo "Pushed to ${dest}"
    ;;
doze)
    require_device
    case "${1:-}" in
        on)
            # Unplugging first is not optional: a device that believes it is
            # charging refuses to go idle, and the force-idle then reports
            # success while nothing happens.
            adb shell dumpsys battery unplug >/dev/null
            adb shell dumpsys deviceidle force-idle
            ;;
        off)
            adb shell dumpsys deviceidle unforce >/dev/null
            adb shell dumpsys battery reset >/dev/null
            echo "Released. The device is charging again."
            ;;
        *) usage >&2; exit 2 ;;
    esac
    ;;
shell)
    require_device
    adb shell "$@"
    ;;
*)
    usage
    [ -z "${cmd}" ] && exit 0 || exit 2
    ;;
esac
